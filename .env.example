# IntentGraph credentials & provider configuration — TEMPLATE.
#
# Copy to `.env` (workspace root — it is
# discovered via a parent-directory walk) and fill in real values. `.env` is
# gitignored; this template is safe to commit precisely because it contains
# no real secrets. Real environment variables always win over this file.
# Full guide: docs/intentgraph.md → "External providers (Phase 3)".

# --- Credentials (one per provider; only the ones you use) ---
# Nebius Token Factory — https://tokenfactory.nebius.com → API keys
NEBIUS_API_KEY=<your-nebius-key>          # NEBIUS_TOKEN_FACTORY_KEY also accepted (lower precedence)
# NVIDIA NIM — https://build.nvidia.com → API keys (nvapi-* format)
NVIDIA_API_KEY=<your-nvidia-nvapi-key>
# Tavily — https://app.tavily.com → API keys (tvly-* format)
TAVILY_API_KEY=<your-tavily-key>

# --- Embedding provider selection (Nebius is the default) ---
# Switch by editing ONLY these two lines. Both providers coexist; each uses
# its own key, endpoint, and model. Switching is safe: stored vectors are
# keyed by provider+model+endpoint, the index refuses to mix embeddings from
# different models, and `intentgraph embed` reindexes after a switch
# (`intentgraph doctor` reports STALE MODEL until you do).
#
#   Nebius (default):
#     INTENTGRAPH_EMBEDDING_PROVIDER=nebius
#     INTENTGRAPH_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
#   NVIDIA NIM:
#     INTENTGRAPH_EMBEDDING_PROVIDER=nvidia
#     INTENTGRAPH_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
#
# Never assume a model id works because a catalog mentions it — verify with
# `intentgraph embed --list-models` against YOUR account first.
INTENTGRAPH_EMBEDDING_PROVIDER=nebius
INTENTGRAPH_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# --- External web search (opt-in; off by default in code) ---
INTENTGRAPH_WEB_SEARCH_PROVIDER=tavily
INTENTGRAPH_WEB_SEARCH_ENABLED=true

# --- Optional: Nebius LLM-assisted retrieval planning ---
# Reasoning models need a larger output budget (llm.max_output_tokens in
# intentgraph.json, e.g. 4096) or plans truncate and fall back to the
# deterministic policy.
# INTENTGRAPH_LLM_PROVIDER=nebius
# INTENTGRAPH_LLM_MODEL=<your-chat-model>

# --- Gnani AI voice (https://app.gnani.ai/voice → API keys) ---
# Powers the Evidence Replay narration in 10 Indian languages + English.
# Without this key, the replay falls back to the browser's built-in TTS.
# GNANI_API_KEY=vach_<your-key>
